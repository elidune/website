---
import BaseLayout from '../components/BaseLayout.astro';
import ContributeBlock from '../components/ContributeBlock.astro';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  kind="contribute"
  title={t(locale, 'meta.contribute.title')}
  description={t(locale, 'meta.contribute.description')}
>
  <ContributeBlock locale={locale} heading="h1" />
</BaseLayout>
