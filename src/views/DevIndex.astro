---
import BaseLayout from '../components/BaseLayout.astro';
import Search from '../components/Search.astro';
import type { Locale } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import { devSectionLabel, groupDevDocs, listDevDocs } from '../lib/devdocs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = groupDevDocs(await listDevDocs(locale));
---

<BaseLayout
  locale={locale}
  kind="dev-index"
  title={t(locale, 'meta.dev.title')}
  description={t(locale, 'meta.dev.description')}
  indexable={true}
>
  <section>
    <div class="wrap" data-pagefind-body data-pagefind-filter={`bundle:${locale}-dev`} data-pagefind-meta={`title:${t(locale, 'meta.dev.title')}`}>
      <p class="kicker">{t(locale, 'dev.kicker')}</p>
      <h1>{t(locale, 'dev.title')}</h1>
      <p class="sub">{t(locale, 'dev.sub')}</p>
      <Search locale={locale} audience="dev" />
      <p><a href={pathFor(locale, 'docs-index')}>{t(locale, 'dev.toDocs')}</a></p>
      <h2 style="margin-top:2.5rem">{t(locale, 'dev.all')}</h2>
      {
        groups.map((group) => (
          <section>
            <h3>{t(locale, devSectionLabel[group.section])}</h3>
            <ol>
              {group.docs.map((doc) => (
                <li>
                  <a href={pathFor(locale, 'dev-doc', doc.slug)}>{doc.entry.data.title}</a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
