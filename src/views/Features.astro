---
import BaseLayout from '../components/BaseLayout.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FeatureTour from '../components/FeatureTour.astro';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  kind="features"
  title={t(locale, 'meta.features.title')}
  description={t(locale, 'meta.features.description')}
>
  <section>
    <div class="wrap">
      <p class="kicker">{t(locale, 'features.kicker')}</p>
      <h1>{t(locale, 'features.title')}</h1>
      <p class="sub">{t(locale, 'features.pageLead')}</p>
      <FeatureGrid locale={locale} heading={false} />
      <FeatureTour locale={locale} />
    </div>
  </section>
</BaseLayout>
