---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { dockerGuideUrl, installYaml } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const code = `${t(locale, 'install.comment1')}\n${t(locale, 'install.comment2')}\n\n${installYaml}\n`;
---

<section id="installer">
  <div class="wrap grid g2" style="gap:3rem;align-items:start">
    <div>
      <p class="kicker">{t(locale, 'install.kicker')}</p>
      <h2>{t(locale, 'install.title')}</h2>
      <p class="sub">{t(locale, 'install.sub')}</p>
      <ol class="steps">
        <li class="step">
          <div>
            <h3>{t(locale, 'install.step1.title')}</h3>
            <p>{t(locale, 'install.step1.body')}</p>
          </div>
        </li>
        <li class="step">
          <div>
            <h3>{t(locale, 'install.step2.title')}</h3>
            <p><code>docker compose -f docker/docker-compose.all-in-one.yml up -d</code></p>
            <p>{t(locale, 'install.step2.body')}</p>
          </div>
        </li>
        <li class="step">
          <div>
            <h3>{t(locale, 'install.step3.title')}</h3>
            <p>{t(locale, 'install.step3.body')}</p>
          </div>
        </li>
      </ol>
      <p style="margin-top:1.25rem"><a class="btn btn-ghost" href={dockerGuideUrl}>{t(locale, 'install.guide')}</a></p>
    </div>
    <div role="region" aria-label={t(locale, 'install.codeLabel')}>
      <pre><code>{code}</code></pre>
    </div>
  </div>
</section>
