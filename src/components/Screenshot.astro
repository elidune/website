---
import type { Locale } from '../i18n/locales';

interface Props {
  name:
    | 'desk'
    | 'record'
    | 'catalogue'
    | 'holds'
    | 'settings'
    | 'opac-loans'
    | 'deposits'
    | 'acquisitions'
    | 'weeding'
    | 'inventory'
    | 'patrons'
    | 'transits';
  locale: Locale;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { name, locale, alt, caption, priority = false } = Astro.props;
const light = `/screens/${locale}/light/${name}.webp`;
const dark = `/screens/${locale}/dark/${name}.webp`;
const lightMobile = `/screens/${locale}/light/${name}-mobile.webp`;
const darkMobile = `/screens/${locale}/dark/${name}-mobile.webp`;
const mobile = '(max-width: 600px)';
---

<figure class="shot">
  <a class="shot-open" href={light} data-shot data-alt={alt} data-caption={caption ?? alt} data-light={light} data-dark={dark} data-light-mobile={lightMobile} data-dark-mobile={darkMobile}>
    <picture>
      <source srcset={darkMobile} media={`${mobile} and (prefers-color-scheme: dark)`} type="image/webp" width="780" height="1688" />
      <source srcset={lightMobile} media={mobile} type="image/webp" width="780" height="1688" />
      <source srcset={dark} media="(prefers-color-scheme: dark)" type="image/webp" />
      <img
        src={light}
        alt={alt}
        width="1440"
        height="900"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </picture>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
